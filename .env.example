# Copia este archivo como .env.local y rellena los valores reales.
# .env.local nunca se sube a git (ver .gitignore).

# Servidor SMTP del proveedor de correo del negocio (Gmail Workspace,
# Outlook 365, el panel del hosting, etc.). Pregunta a quien gestione
# el correo de disnet.es, o mira en la configuración de cuenta de tu
# cliente de correo (normalmente en Ajustes > Cuentas > Servidor saliente).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Dirección que aparecerá como remitente (normalmente igual que SMTP_USER)
SMTP_FROM=info@disnet.es

# Dirección donde quieres recibir los mensajes del formulario de contacto,
# y a quién se le envía copia (CC). Si se dejan vacías, el código usa por
# defecto teomediavilla@disnet.es (to) y murillfr@gmail.com (cc).
CONTACT_TO_EMAIL=teomediavilla@disnet.es
CONTACT_CC_EMAIL=murillfr@gmail.com

# URL final del sitio (para hreflang/canonical y el sitemap). Configúrala
# en Vercel una vez tengas el dominio definitivo.
NEXT_PUBLIC_SITE_URL=https://disnet-site.vercel.app
